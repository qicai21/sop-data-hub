  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/qicai21/projects/repos/sop-data-hub/maintenance/cleanup_check.log</string>
  <key>StandardErrorPath</key><string>/Users/qicai21/projects/repos/sop-data-hub/maintenance/cleanup_check.log</string>
</dict>
</plist>
