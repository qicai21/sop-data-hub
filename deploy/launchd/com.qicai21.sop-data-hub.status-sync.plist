<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qicai21.sop-data-hub.status-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3.14</string>
    <string>scripts/sync_active_shipment_status.py</string>
    <string>--apply</string>
    <string>--closeout</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/qicai21/projects/repos/sop-data-hub</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>src</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- every 2 hours -->
  <key>StartInterval</key><integer>7200</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key>
  <string>/Users/qicai21/projects/repos/sop-data-hub/runtime/status_sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/qicai21/projects/repos/sop-data-hub/runtime/status_sync.log</string>
</dict>
</plist>
